{
  "name": "personal-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal OS — sistema pessoal de gestão e inteligência orientado por dados",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @personal-os/api",
    "dev:web": "npm run dev -w @personal-os/web",
    "build": "npm run build -w @personal-os/web",
    "preview:web": "npm run preview -w @personal-os/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @personal-os/api",
    "test:watch": "npm run test:watch -w @personal-os/api",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "deploy": "npm run build && wrangler deploy --config apps/api/wrangler.toml"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261120.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261119.1": true
  }
}
